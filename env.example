# Copy this file to .env and fill in the values.
# .env is gitignored.

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Database
DB_PATH=./data/app.db

# Uploads
UPLOAD_DIR=./uploads

# Timezone (IANA name, e.g. Europe/Vienna, America/New_York)
TZ=Europe/Vienna

# Encryption key for OAuth tokens at rest (generate with: openssl rand -hex 32)
SECRET_KEY=

# Google Cloud Credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=   # client_email from the downloaded JSON key
GOOGLE_PRIVATE_KEY=             # private_key from the JSON key (the -----BEGIN RSA PRIVATE KEY----- block)

# Google Calendar ID
GOOGLE_CALENDAR_ID=             # Calendar ID from Google Calendar settings (e.g. abc123@group.calendar.google.com)

# Backup directory (default: ./data/backups alongside the DB file)
# BACKUP_DIR=./data/backups

# Vacuum sidecar (Python FastAPI, default port 3001)
VACUUM_SIDECAR_URL=http://localhost:3001
ROBOROCK_USERNAME=               # your Roborock account email
ROBOROCK_PASSWORD=               # your Roborock account password
# ROBOROCK_DEVICE_ID=            # serial number — only needed if you have multiple devices
# VACUUM_DATA_DIR=./data         # override in production: /var/lib/family-planner/vacuum

# Weather (Open-Meteo — no API key required, just set the location coordinates)
WEATHER_LATITUDE=               # e.g. 48.2082 for Vienna
WEATHER_LONGITUDE=              # e.g. 16.3738 for Vienna